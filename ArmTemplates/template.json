{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentTag": {
      "type": "string"
    },
    "parentBusinessTag": {
      "type": "string"
    },
    "portfolioTag": {
      "type": "string"
    },
    "productTag": {
      "type": "string"
    },
    "serviceTag": {
      "type": "string"
    },
    "serviceLineTag": {
      "type": "string"
    },
    "serviceOfferingTag": {
      "type": "string"
    },
    "sharedVirtualNetworkName": {
      "type": "string",
      "metadata": {
        "description": "The name of the shared virtual network"
      }
    },
    "sharedSubnetName": {
      "type": "string",
      "metadata": {
        "description": "The name of the shared subnet on the shared network to attached the app service to"
      }
    },
    "sharedLogAnalyticsName": {
      "type": "string",
      "metadata": {
        "description": "The name of the shared log analytics account"
      }
    },
    "sharedAppInsightsName": {
      "type": "string",
      "metadata": {
        "description": "The name of the shared app insights account"
      }
    },
    "sharedKeyVaultName": {
      "type": "string",
      "metadata": {
        "description": "The name of the shared key vault"
      }
    },
    "linuxAppServicePlanName": {
      "type": "string",
      "metadata": {
        "description": "The name of the hosting plan to host the linus app on"
      }
    },
    "functionAppNameLinux": {
      "type": "string",
      "metadata": {
        "description": "The name of the Linux function app"
      }
    },
    "apimIpAddresses": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-seperated list of ip addresses the APIM instance uses for whitelisting"
      }
    },
    "docCaptureRootFolderLocation": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "the location of the doc capture root folder"
      }
    },
    "FauAPIIPAddress": {
        "type": "string",
        "defaultValue": "",
        "metadata": {
            "description": "FauAPI ip addresses to whitelist"
        }
    }
  },
  "variables": {
    "fundingBuildingBlocksUrl": "https://raw.githubusercontent.com/SkillsFundingAgency/funding-platform-building-blocks/digitalForms/templates/",
    "apimIpAddressesAsArray": "[split(parameters('apimIpAddresses'), ',')]",
    "emptySecurityRules": [],
    "copy": [
      {
        "name": "apimWhiteList",
        "count": "[length(variables('apimIpAddressesAsArray'))]",
        "input": {
          "ipAddress": "[concat(variables('apimIpAddressesAsArray')[copyIndex('apimWhiteList')], '/32')]",
          "action": "Allow",
          "name": "[concat('eapim-ip-address-', copyIndex('apimWhiteList', 1))]"
        }
      }
    ],
    "defaultSecurityRules": [
      {
        "ipAddress": "81.134.140.20/32",
        "action": "Allow",
        "name": "DfE Coventry NAT Block A"
      },
      {
        "ipAddress": "81.134.140.21/32",
        "action": "Allow",
        "name": "DfE Coventry NAT Block B"
      },
      {
        "ipAddress": "81.134.140.22/32",
        "action": "Allow",
        "name": "DfE Coventry NAT Block C"
      },
      {
        "ipAddress": "81.134.140.23/32",
        "action": "Allow",
        "name": "DfE Coventry NAT Block D"
      },
      {
        "ipAddress": "81.134.140.24/32",
        "action": "Allow",
        "name": "DfE Coventry NAT Block E"
      },
      {
        "ipAddress": "81.134.140.25/32",
        "action": "Allow",
        "name": "DfE Coventry NAT Block F"
      },
      {
        "ipAddress": "81.134.140.26/32",
        "action": "Allow",
        "name": "DfE Coventry NAT Block G"
      },
      {
        "ipAddress": "81.134.140.27/32",
        "action": "Allow",
        "name": "DfE Coventry NAT Block H"
      },
      {
        "ipAddress": "81.134.140.28/32",
        "action": "Allow",
        "name": "DfE Coventry NAT Block I"
      },
      {
        "ipAddress": "81.134.140.16/28",
        "action": "Allow",
        "name": "DfE Coventry Primary Range"
      },
      {
        "name": "Global Protect 1",
        "action": "Allow",
        "ipAddress": "208.127.46.232/29"
      },
      {
        "name": "Global Protect 2",
        "action": "Allow",
        "ipAddress": "208.127.46.240/28"
      },
      {
        "name": "virtual network",
        "action": "Allow",
        "ipAddress": "192.168.0.0/24"
      },
      {
          "name": "FauAPI IP",
          "action": "Allow",
          "ipAddress": "[parameters('FauAPIIPAddress')]"
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2018-05-01",
      "name": "linuxFileShifterFunctionApp",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(variables('fundingBuildingBlocksUrl'),'function-app.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "environmentTag": {
            "value": "[parameters('environmentTag')]"
          },
          "parentBusinessTag": {
            "value": "[parameters('parentBusinessTag')]"
          },
          "portfolioTag": {
            "value": "[parameters('portfolioTag')]"
          },
          "productTag": {
            "value": "[parameters('productTag')]"
          },
          "serviceTag": {
            "value": "[parameters('serviceTag')]"
          },
          "serviceLineTag": {
            "value": "[parameters('serviceLineTag')]"
          },
          "serviceOfferingTag": {
            "value": "[parameters('serviceOfferingTag')]"
          },
          "functionAppName": {
            "value": "[parameters('functionAppNameLinux')]"
          },
          "appServicePlanName": {
            "value": "[parameters('linuxAppServicePlanName')]"
          },
          "appServicePlanResourceGroup": {
            "value": "[resourceGroup().name]"
          },
          "functionAppAppSettings": {
            "value": [
              {
                "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                "value": "[reference(concat('Microsoft.Insights/components/', parameters('sharedAppInsightsName')), '2020-02-02-preview').ConnectionString]"
              },
              {
                "name": "AzureWebJobsStorage",
                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'),';SecretName=AzureStorageConnectionString)')]"
              },
              {
                "name": "WEBSITE_TIME_ZONE",
                "value": "GMT Standard Time"
              },
              {
                "name": "WEBSITE_RUN_FROM_PACKAGE",
                "value": "1"
              },
              {
                "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
                "value": "[reference(concat('Microsoft.Insights/components/', parameters('sharedAppInsightsName')), '2020-02-02-preview').InstrumentationKey]"
              },
              {
                "name": "FUNCTIONS_EXTENSION_VERSION",
                "value": "~4"
              },
              {
                "name": "FUNCTIONS_WORKER_RUNTIME",
                "value": "dotnet-isolated"
              },
              {
                "name": "sp_name",
                "value": "educationgovuk"
              },
              {
                "name": "sp_sites",
                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'),';SecretName=DigitalFormsSharepointSiteId)')]"
              },
              {
                "name": "sp_url",
                "value": "https://educationgovuk.sharepoint.com"
              },
              {
                "name": "sp_rootfolder",
                "value": "Shared%20Documents"
              },
              {
                "name": "sp_baseaddress",
                "value": "https://accounts.accesscontrol.windows.net"
              },
              {
                "name": "sp_appid",
                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'),';SecretName=DigitalFormsSharepointClientId)')]"
              },
              {
                "name": "sp_tenantid",
                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'),';SecretName=DigitalFormsSharepointTenantId)')]"
              },
              {
                "name": "sp_secretkey",
                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'),';SecretName=DigitalFormsSharepointClientSecret)')]"
              },
              {
                "name": "dc_RootFolder",
                "value": "[parameters('docCaptureRootFolderLocation')]"
              },
              {
                "name": "CosmosDBConnection",
                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'),';SecretName=CosmosDbConnectionString)')]"
              },
              {
                "name": "CosmosdbName",
                "value": "document-capture-db"
              },
              {
                "name": "CosmosdbContainerName",
                "value": "dc-data"
              },
              {
                "name": "DFSQLAPIURL",
                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'),';SecretName=DFSQLAPIURL)')]"
              },
              {
                "name": "DFSQLAPIKEY",
                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'),';SecretName=DFSQLAPIKEY)')]"
              }
            ]
          },
          "http20Enabled": {
            "value": true
          },
          "subnetResourceId": {
            "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('sharedVirtualNetworkName'), parameters('sharedSubnetName'))]"
          },
          "workspaceId": {
            "value": "[resourceId('microsoft.operationalinsights/workspaces', parameters('sharedLogAnalyticsName'))]"
          },
          "functionAppLogsSetting": {
            "value": true
          },
          "retentionPolicyEnabled": {
            "value": false
          },
          "ipSecurityRestrictions": {
            "value": "[if(empty(parameters('apimIpAddresses')), variables('emptySecurityRules'),  concat(variables('defaultSecurityRules'), variables('apimWhiteList')))]"
          },
          "netFrameworkVersion": {
            "value": "v8.0"
          }
        }
      }
    },
    {
      "apiVersion": "2019-07-01",
      "name": "fileShifterFunctionAppPolicy",
      "type": "Microsoft.Resources/deployments",
      "dependsOn": [ "linuxFileShifterFunctionApp" ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(variables('fundingBuildingBlocksUrl'),'keyvault-accesspolicies.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "keyVaultName": {
            "value": "[parameters('sharedKeyVaultName')]"
          },
          "accessPolicies": {
            "value": [
              {
                "tenantId": "[subscription().tenantId]",
                "objectId": "[reference('linuxFileShifterFunctionApp', '2019-07-01').outputs.managedServiceIdentityId.value]",
                "permissions": {
                  "secrets": [ "list", "get" ]
                }
              }
            ]
          }
        }
      }
    }
  ]
}
